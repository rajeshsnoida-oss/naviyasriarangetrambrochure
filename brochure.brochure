        {
          "type": "textbox",
          "version": "5.5.2",
          "originX": "left",
          "originY": "top",
          "left": 274,
          "top": 269,
          "width": 311.6667,
          "height": 291.088,
          "fill": "#c7c4c2",
          "stroke": null,
          "strokeWidth": 1,
