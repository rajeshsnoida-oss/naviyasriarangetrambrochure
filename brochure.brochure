        },
        {
          "type": "textbox",
          "version": "5.5.2",
          "originX": "left",
          "originY": "top",
          "left": 45,
          "top": 399,
          "width": 700,
          "height": 116.9324,
          "fill": "#c7c4c2",
          "stroke": null,
          "strokeWidth": 1,
          "strokeDashArray": null,
          "strokeLineCap": "butt",
          "strokeDashOffset": 0,
          "strokeLineJoin": "miter",
          "strokeUniform": false,
          "strokeMiterLimit": 4,
          "scaleX": 1,
