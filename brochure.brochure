        {
          "type": "textbox",
          "version": "5.5.2",
          "originX": "left",
          "originY": "top",
          "left": 431,
          "top": 722,
          "width": 310,
          "height": 291.088,
          "fill": "#c7c4c2",
          "stroke": null,
          "strokeWidth": 1,
          "strokeDashArray": null,
          "strokeLineCap": "butt",
