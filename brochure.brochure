          "globalCompositeOperation": "source-over",
          "skewX": 0,
          "skewY": 0,
          "fontFamily": "Playfair Display",
          "fontWeight": "normal",
          "fontSize": 13,
          "text": "Nritya (Expressive Dance): A combination of rhythm and narrative, where the dancer interprets lyrics using stylized hand gestures (Mudras) and vivid facial expressions.",
          "underline": false,
          "overline": false,
          "linethrough": false,
          "textAlign": "justify-left",
